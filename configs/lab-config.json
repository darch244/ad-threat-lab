{
  "domain": {
    "fqdn": "corp.local",
    "netbios": "CORP",
    "base_dn": "DC=corp,DC=local",
    "dc01": "dc01.corp.local"
  },
  "env": {
    "vm_network": "192.168.56.0/24",
    "dc01_ip": "192.168.56.10",
    "ws01_ip": "192.168.56.20",
    "ubuntu_sec_ip": "192.168.56.30"
  },
  "ous": [
    {
      "name": "Tier0",
      "path": "OU=Tier0,DC=corp,DC=local",
      "description": "Tier-0 identity store: domain controllers, DA/EA/BA members.",
      "protected_from_accidental_deletion": true
    },
    {
      "name": "Tier1",
      "path": "OU=Tier1,DC=corp,DC=local",
      "description": "Tier-1 servers and service accounts.",
      "protected_from_accidental_deletion": true
    },
    {
      "name": "Tier2",
      "path": "OU=Tier2,DC=corp,DC=local",
      "description": "Tier-2 workstations and standard users.",
      "protected_from_accidental_deletion": true
    },
    {
      "name": "ServiceAccounts",
      "path": "OU=ServiceAccounts,OU=Tier1,DC=corp,DC=local",
      "description": "gMSA/SPN-bound service accounts (attack surface for Kerberoasting).",
      "protected_from_accidental_deletion": false
    },
    {
      "name": "PrivilegedAccess",
      "path": "OU=PrivilegedAccess,OU=Tier0,DC=corp,DC=local",
      "description": "Jump-host / PAW accounts with Tier-0 grants.",
      "protected_from_accidental_deletion": true
    }
  ],
  "groups": [
    { "name": "Tier0-Admins", "ou_path": "OU=Tier0,DC=corp,DC=local" },
    { "name": "Tier1-Admins", "ou_path": "OU=Tier1,DC=corp,DC=local" },
    { "name": "Tier2-Admins", "ou_path": "OU=Tier2,DC=corp,DC=local" },
    { "name": "SQL-Admins", "ou_path": "OU=ServiceAccounts,OU=Tier1,DC=corp,DC=local" }
  ],
  "users": [
    {
      "sam": "darc-admin",
      "tier": 0,
      "display_name": "DarcHacker Domain Admin",
      "ou_path": "OU=PrivilegedAccess,OU=Tier0,DC=corp,DC=local",
      "group_membership": ["Domain Admins", "Tier0-Admins", "Enterprise Admins"],
      "high_value": true
    },
    {
      "sam": "k.salim",
      "tier": 0,
      "display_name": "Kareem Salim (PAW)",
      "ou_path": "OU=PrivilegedAccess,OU=Tier0,DC=corp,DC=local",
      "group_membership": ["Tier0-Admins"],
      "high_value": true
    },
    {
      "sam": "svc-sql",
      "tier": 1,
