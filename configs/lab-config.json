  "high_value_targets": [
    { "type": "user", "sam": "krbtgt", "reason": "Golden-ticket anchor; DC password hash" },
    { "type": "user", "sam": "darc-admin", "reason": "Domain Admin" },
    { "type": "user", "sam": "svc-sql", "reason": "Kerberoastable Tier-1 service account" },
    { "type": "user", "sam": "backup-op", "reason": "Member of Backup Operators (DCSync)" },
    { "type": "object", "name": "dc01", "reason": "Domain controller; DCSync/DCShadow target" }
  ],
  "spns": [
    "MSSQLSvc/sql01.corp.local:1433",
    "MSSQLSvc/sql01.corp.local:sql01",
    "HTTP/web01.corp.local",
    "HTTP/web01.corp.local:443",
    "cifs/svc-unconst.corp.local",
    "http/svc-rbcd.corp.local"
  ],
  "delegation": [
    { "sam": "svc-unconst", "type": "unconstrained", "spn": "cifs/svc-unconst.corp.local" },
    { "sam": "svc-rbcd", "type": "constrained", "spn": "http/svc-rbcd.corp.local", "allowed_to_act_on": ["DC01$"] }
  ]
}