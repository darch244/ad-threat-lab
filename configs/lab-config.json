      "does_not_require_preauth": true,
      "high_value": false
    },
    {
      "sam": "backup-op",
      "tier": 1,
      "display_name": "Backup Operator (DCSync canary)",
      "ou_path": "OU=Tier1,DC=corp,DC=local",
      "group_membership": ["Backup Operators"],
      "high_value": true
    },
    {
      "sam": "svc-unconst",
      "tier": 1,
