      "spns": [
        "HTTP/web01.corp.local",
        "HTTP/web01.corp.local:443"
      ],
      "high_value": true
    },
    {
      "sam": "t1-admin",
      "tier": 1,
      "display_name": "Tier-1 Server Admin",
      "ou_path": "OU=Tier1,DC=corp,DC=local",
